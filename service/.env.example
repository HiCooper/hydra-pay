# Hydra Pay Service - Environment Variables
# Copy this file to .env and adjust values as needed

# Server
PORT=8081
GIN_MODE=debug
ADMIN_API_PATH=/api/admin
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DATABASE_URL=postgres://hydra:hydra_secret@localhost:5432/hydra_pay?sslmode=disable

# Hydra-Wall integration
WALL_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/payment

# ============ Alipay (支付宝) ============
# App ID from Alipay Open Platform (开放平台应用ID)
ALIPAY_APP_ID=
# Merchant private key PEM content (应用私钥)
ALIPAY_PRIVATE_KEY=
# Path to merchant private key PEM file (alternative to ALIPAY_PRIVATE_KEY)
ALIPAY_PRIVATE_KEY_PATH=
# Alipay public key PEM content (支付宝公钥)
ALIPAY_ALIPAY_PUBLIC_KEY=
# Path to Alipay public key PEM file
ALIPAY_ALIPAY_PUBLIC_KEY_PATH=
# Async notification URL (异步通知地址, must be publicly accessible)
ALIPAY_NOTIFY_URL=https://your-domain.com/v1/payments/callback/alipay
# Return URL for H5/WAP payments (同步跳转地址)
ALIPAY_RETURN_URL=https://your-domain.com/payment/result
# Enable sandbox mode (沙箱环境)
ALIPAY_SANDBOX=false

# ============ WeChat Pay (微信支付) ============
# Merchant ID (商户号)
WECHAT_MCH_ID=
# API v3 key (32-byte key used for callback decryption and auth)
WECHAT_API_V3_KEY=
# Merchant certificate serial number (商户证书序列号)
WECHAT_SERIAL_NO=
# Merchant private key PEM content (商户私钥)
WECHAT_PRIVATE_KEY=
# Path to merchant private key PEM file (alternative to WECHAT_PRIVATE_KEY)
WECHAT_PRIVATE_KEY_PATH=
# Callback notification URL (回调通知地址)
WECHAT_NOTIFY_URL=https://your-domain.com/v1/payments/callback/wechat
# Enable sandbox mode (微信支付测试环境需要单独申请)
WECHAT_SANDBOX=false