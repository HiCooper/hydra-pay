# Hydra Pay Service - Environment Variables
# Copy this file to .env and adjust values as needed

# Server
PORT=8082
GIN_MODE=debug
ADMIN_API_PATH=/api/admin
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database
DATABASE_URL=postgres://hydra:hydra_secret@localhost:5432/hydra_pay?sslmode=disable

# Hydra-Wall integration
WALL_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/payment

# ============ Alipay (支付宝) - Sandbox ============
ALIPAY_APP_ID=9021000123683331

#  (应用私钥)
ALIPAY_ALIPAY_PUBLIC_

# (支付宝公钥)
ALIPAY_PRIVATE_

ALIPAY_SANDBOX=true
ALIPAY_NOTIFY_URL=https://b53e-117-68-201-174.ngrok-free.app/v1/payments/callback/alipay
ALIPAY_RETURN_URL=https://b53e-117-68-201-174.ngrok-free.app

# ============ WeChat Pay (微信支付) ============
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=
WECHAT_SANDBOX=false

# ============ UnionPay (云闪付) - 测试 ============
UNIONPAY_APP_ID=test_app_001
UNIONPAY_SECRET=test_secret_key_for_local_dev
UNIONPAY_MCH_ID=777290058110048
UNIONPAY_PRIVATE_KEY_PATH=./test_priv.pem
UNIONPAY_UNIONPAY_PUBLIC_KEY_PATH=./test_pub.pem
UNIONPAY_SANDBOX=true
UNIONPAY_NOTIFY_URL=http://localhost:8082/v1/payments/callback/unionpay
UNIONPAY_RETURN_URL=http://localhost:8082
