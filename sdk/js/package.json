    "test": "tsx --test __tests__/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hydrapay",
    "payment",
    "alipay",
    "wechat"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
