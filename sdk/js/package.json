{
  "name": "hydrapay",
  "version": "1.0.0",
  "description": "HydraPay API client for Node.js — payments, refunds, subscriptions, checkout, and webhooks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
